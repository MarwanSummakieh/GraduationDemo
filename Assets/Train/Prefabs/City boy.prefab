  m_Script: {fileID: 11500000, guid: be24dda36ecc6a74497f9aca3439b749, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GraduationDemo.Train.TrainObservation
  title: Talk to the city boy
  description: Hey, detective. Best seat in the dining car. What do you want to know?
  speaker: {fileID: 6382650927297126434}
  interactionRange: 3.25
  topics:
  - Introduce yourself
  - The carnival
  - This carriage
  responses:
  - Just a city boy taking a break. No grand title. You can call me the passenger
    with excellent taste in seats.
  - I'm going for the games and the food. Mostly the food. Please don't put that
    in an official report.
  - This booth is perfect. Close to the service counter, far from anyone who expects
    me to look busy.
