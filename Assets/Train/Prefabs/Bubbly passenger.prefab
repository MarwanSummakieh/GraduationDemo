  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be24dda36ecc6a74497f9aca3439b749, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GraduationDemo.Train.TrainObservation
  title: Talk to the bubbly passenger
  description: Oh, a detective! Please, come over. This is an excellent bench for
    watching the world go by.
  speaker: {fileID: 2459186267079241656}
  interactionRange: 3.25
  topics:
  - Introduce yourself
  - The carnival
  - This carriage
  responses:
  - I came for a little adventure and a great deal of spectacle. A train full of
    colourful strangers is a splendid start, wouldn't you say?
  - The music, the costumes, the impossible hats! I intend to see everything. Twice,
    if the programme allows it.
  - The velvet lounge is my favourite. A comfortable seat, a warm cup, and the countryside
    doing all the rushing.
